{
  "$schema": "https://raw.githubusercontent.com/tokens-studio/schema/main/tokens.json",
  "name": "SISYFUZ Brutalist TUI Design System",
  "version": "1.0.0",
  "author": "Dorus Kleijne (sisyfuz.com)",
  "description": "Raw cyber-brutalist, terminal user interface (TUI), and ASCII design tokens for web and desktop applications.",
  "color": {
    "base": {
      "black": { "value": "#000000", "type": "color", "description": "Absolute void black" },
      "surface0": { "value": "#050505", "type": "color", "description": "Primary backdrop (HUDs, panels)" },
      "surface1": { "value": "#0a0a0a", "type": "color", "description": "Secondary deck / raised panels" },
      "surface2": { "value": "#141414", "type": "color", "description": "Hover card / input background" },
      "borderDim": { "value": "#262626", "type": "color", "description": "Subtle 1px architectural divider" },
      "borderMed": { "value": "#333333", "type": "color", "description": "Default button / window border" },
      "borderBright": { "value": "#444444", "type": "color", "description": "Focused frame / active control" },
      "white": { "value": "#ffffff", "type": "color", "description": "Inverted hover fill / primary title" },
      "textBright": { "value": "#f0f0f0", "type": "color", "description": "High-contrast reading text" },
      "textMed": { "value": "#aaaaaa", "type": "color", "description": "Secondary reading text / descriptions" },
      "textDim": { "value": "#666666", "type": "color", "description": "Metadata, labels, inactive tags" }
    },
    "themes": {
      "pink": {
        "id": "pink",
        "name": "SISYFUZ_PINK (Default Signature)",
        "accent": { "value": "#ff0080", "type": "color", "description": "Signature neon hot pink" },
        "accentLight": { "value": "#ff3399", "type": "color" },
        "accentMuted": { "value": "#800040", "type": "color" },
        "accentSurface": { "value": "#2a0014", "type": "color", "description": "Flash alert / tinted background" },
        "glow": { "value": "0 0 10px rgba(255, 0, 128, 0.35)", "type": "boxShadow" }
      },
      "green": {
        "id": "green",
        "name": "MATRIX_GREEN (Cyberdeck)",
        "accent": { "value": "#00ff66", "type": "color", "description": "Phosphor CRT green" },
        "accentLight": { "value": "#33ff88", "type": "color" },
        "accentMuted": { "value": "#008033", "type": "color" },
        "accentSurface": { "value": "#030d05", "type": "color" },
        "glow": { "value": "0 0 10px rgba(0, 255, 102, 0.35)", "type": "boxShadow" }
      },
      "amber": {
        "id": "amber",
        "name": "VT220_AMBER (Retro Terminal)",
        "accent": { "value": "#ffb000", "type": "color", "description": "Amber DEC VT220 phosphor" },
        "accentLight": { "value": "#ffc84d", "type": "color" },
        "accentMuted": { "value": "#805800", "type": "color" },
        "accentSurface": { "value": "#0d0700", "type": "color" },
        "glow": { "value": "0 0 10px rgba(255, 176, 0, 0.35)", "type": "boxShadow" }
      },
      "mono": {
        "id": "mono",
        "name": "PURE_MONOLITH (High Contrast)",
        "accent": { "value": "#ffffff", "type": "color", "description": "Pure white high contrast" },
        "accentLight": { "value": "#ffffff", "type": "color" },
        "accentMuted": { "value": "#888888", "type": "color" },
        "accentSurface": { "value": "#111111", "type": "color" },
        "glow": { "value": "0 0 10px rgba(255, 255, 255, 0.25)", "type": "boxShadow" }
      }
    },
    "status": {
      "live": { "value": "#ff0080", "type": "color" },
      "standby": { "value": "#666666", "type": "color" },
      "success": { "value": "#00ff66", "type": "color" },
      "warning": { "value": "#ffb000", "type": "color" },
      "error": { "value": "#ff0055", "type": "color" },
      "info": { "value": "#00e5ff", "type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "mono": {
        "value": "\"Space Mono\", \"Courier New\", \"Menlo\", monospace",
        "type": "fontFamilies",
        "description": "Primary structural typeface for all TUI elements, tables, and telemetry"
      },
      "display": {
        "value": "\"Sligoil Micro\", \"Space Grotesk\", sans-serif",
        "type": "fontFamilies",
        "description": "Secondary expressive typeface for headlines and art projects"
      }
    },
    "fontSize": {
      "2xs": { "value": "9px", "type": "fontSizes" },
      "xs":  { "value": "10px", "type": "fontSizes" },
      "sm":  { "value": "11px", "type": "fontSizes", "description": "Default baseline TUI font size" },
      "base":{ "value": "12px", "type": "fontSizes" },
      "md":  { "value": "14px", "type": "fontSizes" },
      "lg":  { "value": "18px", "type": "fontSizes" },
      "xl":  { "value": "24px", "type": "fontSizes" },
      "2xl": { "value": "36px", "type": "fontSizes" }
    },
    "fontWeight": {
      "regular": { "value": "400", "type": "fontWeights" },
      "medium":  { "value": "500", "type": "fontWeights" },
      "bold":    { "value": "700", "type": "fontWeights" }
    },
    "letterSpacing": {
      "tight":   { "value": "-0.02em", "type": "letterSpacing" },
      "normal":  { "value": "0em", "type": "letterSpacing" },
      "tracked": { "value": "0.05em", "type": "letterSpacing", "description": "Default for uppercase headers" },
      "wide":    { "value": "0.1em", "type": "letterSpacing" }
    },
    "lineHeight": {
      "dense":   { "value": "1.2", "type": "lineHeights" },
      "standard":{ "value": "1.4", "type": "lineHeights" },
      "spacious":{ "value": "1.6", "type": "lineHeights" }
    }
  },
  "spacing": {
    "1": { "value": "2px", "type": "spacing" },
    "2": { "value": "4px", "type": "spacing" },
    "3": { "value": "6px", "type": "spacing" },
    "4": { "value": "8px", "type": "spacing" },
    "5": { "value": "10px", "type": "spacing" },
    "6": { "value": "12px", "type": "spacing" },
    "8": { "value": "16px", "type": "spacing" },
    "10": { "value": "20px", "type": "spacing" },
    "12": { "value": "24px", "type": "spacing" },
    "16": { "value": "32px", "type": "spacing" }
  },
  "border": {
    "radius": {
      "none": { "value": "0px", "type": "borderRadius", "description": "INVIOLATE RULE: Absolute zero border-radius on all elements" }
    },
    "width": {
      "single": { "value": "1px", "type": "borderWidth" },
      "double": { "value": "2px", "type": "borderWidth" }
    }
  },
  "ascii": {
    "ramp": {
      "standard": { "value": "@%#*+=-:. ", "description": "10-step luminance ramp from dark to light" },
      "extended": { "value": "$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,\"^`'. ", "description": "70-step fine ramp" },
      "blocks":   { "value": "█▓▒░ ", "description": "Unicode CP437 shade blocks" }
    },
    "frameChars": {
      "corner": "+",
      "horizontal": "-",
      "vertical": "|",
      "cross": "+",
      "pointer": ">",
      "cursor": "█",
      "dotEmpty": "○",
      "dotFilled": "●"
    },
    "charAspectCompensation": {
      "value": 0.52,
      "description": "Width-to-height ratio for Space Mono monospace character grid"
    }
  },
  "audio": {
    "chirp": {
      "type": "sine",
      "startFrequencyHz": 880,
      "endFrequencyHz": 587,
      "durationSeconds": 0.08,
      "peakGain": 0.12,
      "description": "Non-intrusive dual-tone retro alert chirp synthesized via Web Audio API"
    }
  }
}
