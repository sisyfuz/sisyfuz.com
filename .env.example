# ==============================================================================
# SISYFUZ CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate the secrets.
# NEVER commit .env.local or raw credentials to git!
# ==============================================================================

# Shared Broadcast Secret for authenticating live updates to Cloudflare Worker
# (Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))')
BROADCAST_SECRET=your_32_byte_hex_secret_here

# Metered.ca TURN Relay Credentials for WebRTC Ultra-Low Latency (<300ms)
METERED_TURN_HOST=global.relay.metered.ca
METERED_TURN_USERNAME=your_metered_username
METERED_TURN_CREDENTIAL=your_metered_credential
